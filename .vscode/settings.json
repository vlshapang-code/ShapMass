{
    // The Rust projects live in mac/rust/ and windows/rust/, not the repo root.
    "rust-analyzer.linkedProjects": ["mac/rust/Cargo.toml", "windows/rust/Cargo.toml"],
    // Debug builds of the GUI are very slow; make the Run link build with --release.
    "rust-analyzer.runnables.extraArgs": ["--release"],

    // Python: use the project's .venv. On Windows it is a conda env (python.exe sits in .venv\,
    // not .venv\Scripts\), which VS Code doesn't auto-detect; the Mac pip venv is found as usual.
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/python.exe",
    // New Windows terminals (and so the Code Runner ▷ button) get .venv first on PATH, so plain `python` is the venv.
    "terminal.integrated.env.windows": {
        "PATH": "${workspaceFolder}\\.venv;${workspaceFolder}\\.venv\\Scripts;${env:USERPROFILE}\\.cargo\\bin;${env:PATH}"
    },
    // New Mac terminals get cargo on PATH, so the Code Runner command below can call plain `cargo`.
    "terminal.integrated.env.osx": {
        "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
    },

    // Code Runner: the ▷ button in the top-right of the editor. For Rust it runs the whole app the
    // open file belongs to. The command must parse in both zsh (Mac) and PowerShell 5.1 (Windows):
    // Code Runner turns `&&` into `; if ($?) { ... }` for PowerShell, but bash-only syntax like
    // `[ -f ... ] || ...` breaks it. ($dir is already quoted by Code Runner.)
    // `cd rust` steps from mac/main.rs into mac/rust/; where there is no rust/ subfolder
    // (e.g. windows/rust/main.rs) it prints a harmless error and cargo runs from $dir.
    // (executorMapByGlob can't split mac/ from windows/: it matches only the file name, not the path.)
    "code-runner.executorMap": {
        "rust": "cd $dir && cd rust; cargo run --release"
    },
    "code-runner.runInTerminal": true,
    "code-runner.saveAllFilesBeforeRun": true,
    "code-runner.clearPreviousOutput": true,
    "python-envs.defaultEnvManager": "ms-python.python:system"
}
